---
// Prerender this page for optimal performance
export const prerender = true;

import { getCollection } from 'astro:content';
import { getBlogPostUrl, getBlogUrlSlug } from '../../lib/blog';
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import BlogPagination from '../../components/BlogPagination.astro';
import {
  getPublishedBlogPosts,
  getBlogTotalPages,
  getBlogPageSlice,
} from '../../lib/blog-pagination';

// Default to English for /blog route
const lang = 'en';

// Get all published blog posts for the current language and sort by date
const allPosts = await getCollection('blog');
const posts = getPublishedBlogPosts(allPosts, lang);
const totalPages = getBlogTotalPages(posts.length);
const pagePosts = getBlogPageSlice(posts, 1);

// SEO metadata
const title = 'Blog - Vasileios Politeiadis';
const description =
  'Insights on technology, creativity, and the intersection of human and artificial intelligence.';

const currentPath = '/blog';

// Build breadcrumb
const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: currentPath },
];

// Build Blog structured data
const blogSchema = {
  '@type': 'Blog',
  'name': 'Vasileios Politeiadis Blog',
  'description': description,
  'url': new URL(currentPath, Astro.site).toString(),
  'inLanguage': lang,
  'blogPost': posts.slice(0, 10).map((post) => {
    const postUrl = getBlogPostUrl(post);
    return {
      '@type': 'BlogPosting',
      'headline': post.data.title,
      'description': post.data.description,
      'author': {
        '@type': 'Person',
        'name': post.data.author,
      },
      'datePublished': new Date(post.data.publishedAt).toISOString(),
      'url': new URL(postUrl, Astro.site).toString(),
      'inLanguage': post.data.lang || 'en',
    };
  }),
};
---

<MainLayout 
  title={title}
  description={description}
  currentPath={currentPath}
  bgSlug="blog-bg"
  bgEager={true}
  lang={lang}
>
  <!-- Structured Data -->
  <SchemaOrg schema={blogSchema} />

  <div class="relative content-visibility-auto" data-testid="page-blog">
    <PageHero 
      title="Blog"
      description="Insights on technology, creativity, and the intersection of human and artificial intelligence."
      eager={true}
    >
    </PageHero>

    <!-- Breadcrumb (Hidden visually, visible to search engines) -->
    <Breadcrumb items={breadcrumbItems} class="sr-only" />

  <!-- Blog Content -->
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Minimalist List -->

      <!-- All Posts -->
      <div class="mb-16">
           <h2 class="text-2xl font-orbitron font-bold text-secondary mb-8">
          📝 All Posts
        </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="posts-grid" data-testid="blog-posts-grid">
          {pagePosts.map(post => {
            const postUrl = getBlogPostUrl(post);
            return (
              <BlogPostCard
                post={{
                  slug: getBlogUrlSlug(post),
                  title: post.data.title,
                  excerpt: post.data.excerpt,
                  description: post.data.description,
                  coverImage: post.data.coverImage,
                  tags: post.data.tags,
                  publishedAt: post.data.publishedAt,
                  readingTime: post.data.readingTime,
                  url: postUrl
                }}
                class="card"
              />
            );
          })}
        </div>

        <BlogPagination
          currentPage={1}
          totalPages={totalPages}
          totalPosts={posts.length}
        />

        <!-- No Results Message -->
        <div id="no-results" class="hidden text-center py-12" aria-live="polite" hidden>
          <div class="text-6xl mb-4">🔍</div>
          <h3 class="text-xl font-orbitron font-bold text-matrix-white/60 mb-2">
            No articles found
          </h3>
          <p class="text-matrix-white/60">
            Try a different search or clear the tag filter
          </p>
        </div>
      </div>

      <!-- Newsletter Signup (disabled) - Section hidden/commented out per request
      <div class="card" data-testid="newsletter-signup">
        <div class="text-center">
          <h2 class="text-2xl font-orbitron font-bold text-neon-lime mb-4">
            📧 Stay Updated
          </h2>
          <p class="text-matrix-white/90 mb-6 max-w-2xl mx-auto">
            Get notified when I publish new articles about technology, creativity, and AI. 
            No spam, just valuable insights delivered to your inbox.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
            <input 
              type="email" 
              placeholder="Enter your email" 
              class="flex-1 px-4 py-3 bg-cyber-gray border border-neon-lime/20 rounded-lg text-matrix-white placeholder-matrix-white/50 focus:border-neon-lime/50 focus:outline-none"
              aria-label="Email address for newsletter subscription"
              data-testid="newsletter-email-input"
            >
            <button class="btn-primary whitespace-nowrap" data-testid="newsletter-subscribe-button">
              Subscribe
            </button>
          </div>
        </div>
      </div>
      -->
    </div>
  </section>
    </div>
</MainLayout>

<script is:inline src="/scripts/blog-index.js" defer></script>