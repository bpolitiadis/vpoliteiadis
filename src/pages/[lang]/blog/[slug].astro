---
// Prerender this page for optimal performance
export const prerender = true;

import { getCollection } from 'astro:content';
import { getBlogUrlSlug, getBlogPostUrl } from '../../../lib/blog';
import MainLayout from '../../../layouts/MainLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import SchemaOrg from '../../../components/SchemaOrg.astro';
import AImage from '../../../components/media/AImage.astro';
import LanguageSwitcher from '../../../components/LanguageSwitcher.astro';

// Generate static paths for all blog posts with their languages
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const paths: Array<{ params: { lang: string; slug: string }; props: { post: any; alternateLang?: string } }> = [];
  
  // Only generate paths for non-default languages (el)
  // Default language (en) uses /blog/[slug].astro
  for (const post of posts) {
    if (post.data.draft) continue;
    
    const lang = post.data.lang || 'en';
    
    // Skip default locale (en) - it uses the other route
    if (lang === 'en') continue;
    
    paths.push({
      params: { lang, slug: getBlogUrlSlug(post) },
      props: { post },
    });
  }
  
  return paths;
}

// Get the current post and related posts
const { lang, slug } = Astro.params;
const { post } = Astro.props;
const { Content } = await post.render();

// Verify the post matches the requested language
if (post.data.lang !== lang) {
  return Astro.redirect('/404');
}

// Get related posts based on tags and category (same language)
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => 
    p.slug !== post.slug && 
    !p.data.draft &&
    p.data.lang === lang &&
    (p.data.tags.some(tag => post.data.tags.includes(tag)) || 
     p.data.category === post.data.category)
  )
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
  .slice(0, 3);

// Find alternate language post for language switcher
let alternatePost: typeof post | undefined;
if (post.data.translationId) {
  alternatePost = allPosts.find(
    p => 
      p.data.translationId === post.data.translationId && 
      p.data.lang !== lang &&
      !p.data.draft
  );
}

// SEO metadata
const title = post.data.seo?.title || `${post.data.title} - Vasileios Politeiadis`;
const description = post.data.seo?.description || post.data.description;
const publishedDate = new Date(post.data.publishedAt).toISOString();
const modifiedDate = post.data.updatedAt ? new Date(post.data.updatedAt).toISOString() : publishedDate;

// Build URLs for current and alternate languages
const currentUrl = `/${lang}/blog/${slug}`;
const alternateUrl = alternatePost ? getBlogPostUrl(alternatePost) : undefined;

// Build breadcrumb
const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: `/${lang}/blog` },
  { name: post.data.title, href: currentUrl },
];

// Build inline structured data schema for blog post
const blogPostSchema = {
  '@type': 'BlogPosting',
  'headline': post.data.title,
  'description': post.data.description,
  'author': {
    '@type': 'Person',
    'name': post.data.author,
  },
  'datePublished': publishedDate,
  'dateModified': modifiedDate,
  'publisher': {
    '@type': 'Person',
    'name': 'Vasileios Politeiadis',
  },
  'keywords': (post.data.seo?.keywords || post.data.tags).join(', '),
  'image': post.data.coverImage
    ? new URL(post.data.coverImage, Astro.site).toString()
    : new URL('/images/vp-logo-800w.webp', Astro.site).toString(),
  'url': new URL(currentUrl, Astro.site).toString(),
  'inLanguage': lang,
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': new URL(currentUrl, Astro.site).toString(),
  },
};

// Prepare hreflang data for MainLayout
const hreflangLinks: Array<{ hreflang: string; href: string }> = [
  { hreflang: lang, href: new URL(currentUrl, Astro.site).toString() },
];
if (alternateUrl) {
  hreflangLinks.push({
    hreflang: alternatePost!.data.lang || 'en',
    href: new URL(alternateUrl, Astro.site).toString(),
  });
}
hreflangLinks.push({ hreflang: 'x-default', href: new URL(currentUrl, Astro.site).toString() });
---

<MainLayout 
  title={title}
  description={description}
  currentPath={currentUrl}
  type="article"
  publishedAt={publishedDate}
  updatedAt={modifiedDate}
  author={post.data.author}
  image={post.data.coverImage || '/images/vp-logo-800w.webp'}
  lang={lang}
  hreflangLinks={hreflangLinks}
>
  <!-- Structured Data for Blog Post -->
  <SchemaOrg schema={blogPostSchema} />

  <!-- Hero Section with background cover image -->
  <section class="relative overflow-hidden py-28 lg:py-36">
    <!-- Background Image (decorative) -->
    {post.data.coverImage && (
      <>
        <img 
          src={post.data.coverImage}
          alt=""
          class="absolute inset-0 z-0 h-full w-full object-cover object-center opacity-50 md:opacity-60 scale-105 will-change-transform mask-fade-b"
          aria-hidden="true"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          sizes="100vw"
        />
        <!-- Overlays for readability and brand feel -->
        <div class="absolute inset-0 z-0 bg-gradient-to-b from-black/60 via-black/40 to-black/80"></div>
        <div class="absolute inset-0 z-0 vignette-soft"></div>
      </>
    )}
    {!post.data.coverImage && (
      <div class="absolute inset-0 z-0 bg-gradient-to-br from-background via-muted to-background"></div>
    )}

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <!-- Breadcrumb with Structured Data (Hidden visually, visible to search engines) -->
        <Breadcrumb items={breadcrumbItems} class="sr-only" />

        <!-- Language Switcher -->
        {alternatePost && (
          <div class="mb-6 flex justify-center">
            <LanguageSwitcher 
              currentLang={lang || 'el'}
              alternateLang={alternatePost.data.lang || 'en'}
              alternateUrl={alternateUrl || ''}
            />
          </div>
        )}

        <!-- Content (no box/border) -->
        <div class="mx-auto max-w-4xl">
          <!-- Article Meta -->
          <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-matrix-white/80 mb-4">
            <span>{new Date(post.data.publishedAt).toLocaleDateString(lang === 'el' ? 'el-GR' : 'en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}</span>
            {post.data.readingTime && (
              <>
                <span aria-hidden="true">•</span>
                <span>{post.data.readingTime}</span>
              </>
            )}
            <span aria-hidden="true">•</span>
            <span>By {post.data.author}</span>
          </div>

          <!-- Title -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-orbitron font-bold text-neon-lime tracking-tight leading-[1.15] md:leading-tight text-balance break-words hyphens-auto text-shadow-none sm:text-glow mb-4">
            {post.data.title}
          </h1>

          <!-- Description -->
          <p class="text-lg sm:text-xl text-matrix-white/90 max-w-3xl mx-auto mb-6">
            {post.data.description}
          </p>

          <!-- Tags -->
          <div class="flex flex-wrap justify-center gap-2">
            {post.data.tags.map((tag: string) => (
              <span class="px-3 py-1 bg-primary/10 text-primary text-sm rounded-full border border-primary/20">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Article Content -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Cover image moved to hero background -->

      <!-- Article Body -->
       <article class="prose prose-invert prose-lg max-w-none">
        <div class="card">
          <Content />
        </div>
      </article>

      <!-- Article Footer -->
      <div class="mt-12 pt-8 border-t border-cyber-gray/30">
        <div class="flex items-center justify-between text-sm text-matrix-white/60">
          <div class="flex items-center space-x-4">
            <span>Published: {new Date(post.data.publishedAt).toLocaleDateString(lang === 'el' ? 'el-GR' : 'en-US')}</span>
            {post.data.updatedAt && (
              <>
                <span>•</span>
                <span>Updated: {new Date(post.data.updatedAt).toLocaleDateString(lang === 'el' ? 'el-GR' : 'en-US')}</span>
              </>
            )}
          </div>
          <div class="flex items-center space-x-4">
            <span>Category: {post.data.category}</span>
            <span>•</span>
            <span>{post.data.tags.length} tags</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Posts -->
  {relatedPosts.length > 0 && (
    <section class="py-16 bg-cyber-gray/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-orbitron font-bold text-neon-lime mb-8 text-center">
          📚 Related Articles
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {relatedPosts.map(relatedPost => {
            const relatedPostUrl = getBlogPostUrl(relatedPost);
            return (
              <article class="card group hover:scale-[1.02] transition-transform duration-300">
                  {relatedPost.data.coverImage && (
                    <div class="mb-4">
                      <AImage
                        src={relatedPost.data.coverImage}
                        alt={`Cover image for ${relatedPost.data.title}`}
                        preset="thumb"
                        class="w-full h-40 object-cover rounded-lg"
                        loading="lazy"
                        decoding="async"
                        sizes="(max-width: 768px) 100vw, 400px"
                        usePicture={false}
                      />
                    </div>
                  )}
                <div class="space-y-3">
                  <div class="flex items-center space-x-4 text-sm text-matrix-white/60">
                    <span>{new Date(relatedPost.data.publishedAt).toLocaleDateString(lang === 'el' ? 'el-GR' : 'en-US', { month: 'short', year: 'numeric' })}</span>
                    {relatedPost.data.readingTime && (
                      <>
                        <span>•</span>
                        <span>{relatedPost.data.readingTime}</span>
                      </>
                    )}
                  </div>
                  <h3 class="text-lg font-orbitron font-bold text-neon-lime">
                    <a href={relatedPostUrl} class="hover:text-glow transition-all duration-300">
                      {relatedPost.data.title}
                    </a>
                  </h3>
                  <p class="text-matrix-white/80 text-sm">
                    {relatedPost.data.excerpt || relatedPost.data.description}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {relatedPost.data.tags.slice(0, 2).map((tag: string) => (
                      <span class="px-2 py-1 bg-neon-lime/10 text-neon-lime text-xs rounded">{tag}</span>
                    ))}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Back to Blog -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a href={`/${lang}/blog`} class="btn-primary">
        ← Back to Blog
      </a>
    </div>
  </section>
</MainLayout>

<style>
  /* Custom styles for MDX content */
  .prose {
    color: var(--foreground);
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    font-family: 'Orbitron', sans-serif;
    font-weight: 700;
    color: var(--primary);
  }

  .prose h1 {
    font-size: 1.875rem;
    line-height: 2.25rem;
    margin-bottom: 2rem;
  }

  .prose h2 {
    font-size: 1.5rem;
    line-height: 2rem;
    margin-bottom: 1.5rem;
    margin-top: 3rem;
  }

  .prose h3 {
    font-size: 1.25rem;
    line-height: 1.75rem;
    margin-bottom: 1rem;
    margin-top: 2rem;
  }

  .prose p {
    color: color-mix(in oklab, var(--foreground) 90%, transparent);
    line-height: 1.625;
    margin-bottom: 1.5rem;
  }

  .prose ul,
  .prose ol {
    color: color-mix(in oklab, var(--foreground) 90%, transparent);
    margin-bottom: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose strong {
    color: var(--primary);
    font-weight: 600;
  }

  .prose em {
    color: var(--secondary);
    font-style: italic;
  }

  .prose a {
    color: var(--primary);
    text-decoration: underline;
    transition: all 0.3s;
  }

  .prose a:hover {
    color: var(--foreground);
  }

  .prose blockquote {
    border-left: 4px solid var(--primary);
    padding-left: 1.5rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
    background-color: color-mix(in oklab, var(--muted) 30%, transparent);
    border-top-right-radius: 0.5rem;
    border-bottom-right-radius: 0.5rem;
    font-style: italic;
  }

  .prose code {
    background-color: var(--muted);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    color: var(--primary);
    font-size: 0.875rem;
  }

  .prose pre {
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
  }

  .prose pre code {
    background-color: transparent;
    padding: 0;
    color: var(--foreground);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid color-mix(in oklab, var(--muted) 30%, transparent);
  }

  .prose th,
  .prose td {
    border: 1px solid color-mix(in oklab, var(--muted) 30%, transparent);
    padding: 0.5rem 1rem;
    text-align: left;
  }

  .prose th {
    background-color: color-mix(in oklab, var(--muted) 50%, transparent);
    color: var(--primary);
    font-family: 'Orbitron', sans-serif;
  }

  .prose img {
    border-radius: 0.5rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  /* Syntax highlighting for code blocks */
  .prose pre {
    position: relative;
  }

  .prose pre::before {
    content: attr(data-language);
    position: absolute;
    top: 0.5rem;
    right: 1rem;
    font-size: 0.75rem;
    color: color-mix(in oklab, var(--foreground) 60%, transparent);
    background-color: color-mix(in oklab, var(--muted) 50%, transparent);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
  }
</style>
